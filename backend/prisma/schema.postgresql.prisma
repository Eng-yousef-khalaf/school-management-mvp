generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  passwordHash String
  fullName     String
  role         String     @default("STAFF")
  photoUrl     String?
  active       Boolean    @default(true)
  teacherId    Int?       @unique
  teacher      Teacher?   @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  auditLogs    AuditLog[]
  recordedPayments Payment[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([email])
  @@index([role])
}

model AcademicYear {
  id          Int           @id @default(autoincrement())
  name        String        @unique
  startDate   DateTime
  endDate     DateTime
  active      Boolean       @default(false)
  classes     SchoolClass[]
  enrollments Enrollment[]
  fees        StudentFee[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([active])
}

model SchoolClass {
  id             Int                   @id @default(autoincrement())
  name           String
  grade          String
  section        String?
  academicYearId Int
  academicYear   AcademicYear          @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  enrollments    Enrollment[]
  teacherLinks   TeacherClassSubject[]
  attendance     Attendance[]
  grades         Grade[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([name, academicYearId])
  @@index([academicYearId])
  @@index([grade])
}

model Student {
  id            Int          @id @default(autoincrement())
  studentNumber String       @unique
  firstName     String
  middleName    String?
  lastName      String
  gender        String?
  dateOfBirth   DateTime?
  phone         String?
  parentName    String?
  parentPhone   String?
  address       String?
  photoUrl      String?
  status        String       @default("ACTIVE")
  enrollments   Enrollment[]
  attendance    Attendance[]
  grades        Grade[]
  fees          StudentFee[]
  payments      Payment[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([studentNumber])
  @@index([lastName, firstName])
  @@index([firstName])
  @@index([lastName])
  @@index([status])
  @@index([parentPhone])
}

model Teacher {
  id           Int                   @id @default(autoincrement())
  employeeNo   String                @unique
  firstName    String
  lastName     String
  phone        String?
  email        String?
  specialty    String?
  photoUrl     String?
  active       Boolean               @default(true)
  user         User?
  teacherLinks TeacherClassSubject[]
  attendance   TeacherAttendance[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([employeeNo])
  @@index([lastName, firstName])
  @@index([firstName])
  @@index([lastName])
  @@index([active])
}

model TeacherAttendance {
  id        Int      @id @default(autoincrement())
  teacherId Int
  date      DateTime
  status    String   @default("PRESENT")
  checkIn   String?
  note      String?
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teacherId, date])
  @@index([date])
  @@index([teacherId])
  @@index([status])
}

model Subject {
  id           Int                   @id @default(autoincrement())
  code         String                @unique
  name         String
  active       Boolean               @default(true)
  teacherLinks TeacherClassSubject[]
  grades       Grade[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([code])
  @@index([name])
}

model TeacherClassSubject {
  id        Int         @id @default(autoincrement())
  teacherId Int
  classId   Int
  subjectId Int
  teacher   Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class     SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([teacherId, classId, subjectId])
  @@index([teacherId])
  @@index([classId])
  @@index([subjectId])
}

model Enrollment {
  id             Int           @id @default(autoincrement())
  studentId      Int
  classId        Int
  academicYearId Int?
  enrolledAt     DateTime      @default(now())
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class          SchoolClass   @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())

  @@unique([studentId, classId])
  @@index([studentId])
  @@index([classId])
  @@index([academicYearId])
}

model Attendance {
  id        Int          @id @default(autoincrement())
  studentId Int
  classId   Int?
  date      DateTime
  status    String       @default("PRESENT")
  note      String?
  student   Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class     SchoolClass? @relation(fields: [classId], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([studentId, date])
  @@index([date])
  @@index([studentId])
  @@index([classId])
  @@index([status])
}

model Grade {
  id        Int          @id @default(autoincrement())
  studentId Int
  subjectId Int
  classId   Int?
  examName  String
  score     Float
  maxScore  Float        @default(100)
  date      DateTime     @default(now())
  student   Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject   Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class     SchoolClass? @relation(fields: [classId], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([studentId])
  @@index([subjectId])
  @@index([classId])
  @@index([examName])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  entity    String
  entityId  String?
  metadata  String?
  ipAddress String?
  timestamp DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([timestamp])
}

model StudentFee {
  id             Int           @id @default(autoincrement())
  studentId      Int
  academicYearId Int?
  totalAmount    Float         @default(1500)
  discountAmount Float         @default(0)
  paidAmount     Float         @default(0)
  currency       String        @default("ILS")
  dueDate        DateTime?
  status         String        @default("UNPAID")
  notes          String?
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  payments       Payment[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([studentId, academicYearId])
  @@index([studentId])
  @@index([status])
  @@index([academicYearId])
}

model Payment {
  id                Int         @id @default(autoincrement())
  studentFeeId      Int?
  studentId         Int
  amount            Float
  currency          String      @default("ILS")
  method            String      // CASH, BANK_OF_PALESTINE, JAWWAL_PAY, PALPAY, SPONSOR_GRANT
  status            String      @default("COMPLETED") // COMPLETED, PENDING_VERIFICATION, REJECTED
  payerName         String?
  payerRelationship String?     // FATHER, MOTHER, GUARDIAN, SPONSOR, SELF, OTHER
  payerPhone        String?
  transactionRef    String?
  receiptNumber     String?     @unique
  proofUrl          String?
  notes             String?
  recordedByUserId  Int?
  recordedByUser    User?       @relation(fields: [recordedByUserId], references: [id], onDelete: SetNull)
  studentFee        StudentFee? @relation(fields: [studentFeeId], references: [id], onDelete: SetNull)
  student           Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([studentId])
  @@index([method])
  @@index([status])
  @@index([receiptNumber])
  @@index([createdAt])
}
