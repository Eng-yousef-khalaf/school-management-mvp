{
  "name": "school-mvp-backend",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node prisma/seed.js",
    "db:reset": "node prisma/reset_clean_slate.js",
    "prisma:generate": "node scripts/prisma-generate.js",
    "prisma:supabase:generate": "prisma generate --schema=prisma/schema.postgresql.prisma",
    "prisma:migrate": "prisma migrate dev",
    "prisma:supabase": "prisma db push --schema=prisma/schema.postgresql.prisma",
    "setup:db": "node scripts/setup-database.js"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "xlsx": "^0.18.5",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "prisma": "^6.16.0"
  }
}