# ==============================================================================
# SCHOOL MANAGEMENT SYSTEM V2 — BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Database Connection URL
# For Supabase PostgreSQL (Dedicated School Instance):
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?schema=public"
# For Local Dev (PostgreSQL Docker or SQLite fallback):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/school_mvp?schema=public"

# 2. Authentication & Security
JWT_SECRET="your-jwt-secret-here"
PORT=4000
CORS_ORIGIN="http://localhost:5173,https://your-frontend-domain.com"

# 3. Developer Master Access Key (Platform Owner)
DEVELOPER_MASTER_KEY="your-developer-master-key-here"

# 4. School Metadata & Storage Allocation
SCHOOL_CODE="SCH-001"
SCHOOL_NAME_AR="مدرسة النور النموذجية"
SCHOOL_NAME_EN="Al-Noor Model School"
ALLOCATED_STORAGE_MB=500
