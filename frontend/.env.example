# ==============================================================================
# SMART SCHOOL MANAGEMENT SYSTEM — STANDALONE FRONTEND CONFIGURATION
# ==============================================================================

# 1. Backend API Endpoint
# Production (Render / Railway / VPS / Cloud): https://api.your-school-domain.com/api
# Local Development: http://localhost:4000/api
VITE_API_URL=http://localhost:4000/api

# 2. School Identity & Branding Customization
VITE_SCHOOL_CODE="SCH-ALSALAM-2026"
VITE_SCHOOL_NAME_AR="روضة ومدرسة مجموعة السلام التعليمية الخاصة"
VITE_SCHOOL_NAME_EN="Al-Salam Educational Group Private School & Kindergarten"
VITE_SCHOOL_SLOGAN_AR="البيئة التعليمية النموذجية الأولى في فلسطين - خبرة 25 عاماً من الإبداع والتميز"
VITE_SCHOOL_SLOGAN_EN="Palestine's Premier Model Educational Environment - 25 Years of Excellence"

# Custom School Logo (URL to PNG/SVG, or leave blank to use default emblem)
VITE_SCHOOL_LOGO_URL="/school-logo.png"

# 3. Dynamic Theme & Brand Colors
VITE_PRIMARY_COLOR="#4f46e5"
VITE_PRIMARY_HOVER="#4338ca"

# 4. Storage Quota Allocation (in MB)
VITE_ALLOCATED_STORAGE_MB=500

# 5. Support & Contact Information
VITE_SUPPORT_EMAIL="info@alsalam-school.edu.ps"
VITE_SUPPORT_PHONE="+970 59 312 4444"
